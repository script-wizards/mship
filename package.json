{
  "name": "mship",
  "version": "0.0.1",
  "private": true,
  "description": "Fast CLI tools for running a Mothership game at the table",
  "bin": {
    "mship": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "mship": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "audit": "bun run scripts/audit.ts",
    "check": "oxfmt --check . && oxlint && bun test"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0"
  }
}
